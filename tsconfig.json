{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "noEmit": true,
    "noEmitOnError": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["frontend/*.tsx", "frontend/*.ts", "frontend/components/**/*.tsx"]
}
